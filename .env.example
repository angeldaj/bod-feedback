# URL absoluta del backend de La Bodega (la-bodega-api), incluido el prefijo /api.
# La landing vive en otro origen (labodega.com) y envía el feedback aquí; los
# endpoints de envío son públicos. Si se omite, se usa el valor de producción.
NEXT_PUBLIC_API_BASE_URL=https://app.bod-service.cloud/api

# Bodega Club v2 (mi-club). Fuente de datos de tarjeta/diseños/Wallet:
# "mock" (por defecto, datos de ejemplo en memoria) o "api" (endpoints de la
# spec de bodega-api, cuando existan). Ver src/lib/club-api.ts.
NEXT_PUBLIC_CLUB_V2_SOURCE=mock
# "1" abre mi-club sin iniciar sesión, con una socia de ejemplo. Solo para
# revisar el diseño en local; no activar en producción.
NEXT_PUBLIC_CLUB_V2_DEMO=0
